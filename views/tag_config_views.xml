<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- The setup lives on the category because the product already carries its categ_id:
       nobody has to tag a piece with its family by hand. -->
  <record id="view_product_category_tag_form" model="ir.ui.view">
    <field name="name">product.category.form.tag</field>
    <field name="model">product.category</field>
    <field name="inherit_id" ref="product.product_category_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <notebook>
          <page string="Tag" name="yag_tag">
            <div class="alert alert-info" role="alert">
              What a piece of this family prints on its Zebra tag. The cardboard is
              die-cut: there are eight cells and no more, one attribute each, and an
              empty cell prints empty -- nothing moves up to fill a gap.
              <br/>
              Leave the cell empty for an attribute that should be loaded but not printed.
              <br/>
              A category with no setup of its own follows its parent branch.
            </div>
            <group>
              <field name="yag_tag_heredada_de" readonly="1"
                     invisible="not yag_tag_heredada_de"/>
              <field name="yag_tag_lineas" readonly="1"/>
            </group>
            <field name="yag_tag_line_ids">
              <!-- The list does NOT edit inline. Changing the cell on a row raised
                   an Owl DOM patch error ("the node before which the new node is to be
                   inserted is not a child of this node"), twice, and it is not worth
                   guessing at a rendering bug we cannot reproduce from the server. A row
                   opens in a dialog instead, which is one click more and does not break.
                   Dragging to reorder still works: the handle does not need inline edit. -->
              <list>
                <field name="sequence" widget="handle"/>
                <field name="attribute_id"/>
                <field name="cell_id"/>
                <field name="admite_varios"/>
                <field name="obligatorio"/>
                <field name="condicion_attribute_id" string="Conditional on" optional="show"/>
                <field name="create_variant" readonly="1"/>
              </list>
              <form>
                <group>
                  <field name="attribute_id"/>
                  <field name="cell_id"/>
                  <field name="create_variant" readonly="1"/>
                  <field name="admite_varios"/>
                  <field name="obligatorio"/>
                </group>
                <group string="Only ask this when...">
                  <field name="condicion_attribute_id"/>
                  <field name="condicion_value_id" invisible="not condicion_attribute_id"/>
                </group>
              </form>
            </field>
          </page>
        </notebook>
      </xpath>
    </field>
  </record>

  <!-- Seeing at a glance which branches are already set up -->
  <record id="view_product_category_tag_list" model="ir.ui.view">
    <field name="name">product.category.list.tag</field>
    <field name="model">product.category</field>
    <field name="inherit_id" ref="product.product_category_list_view"/>
    <field name="arch" type="xml">
      <field name="display_name" position="after">
        <field name="yag_tag_lineas" string="Tag attributes" optional="show"/>
        <field name="yag_tag_heredada_de" string="Inherits from" optional="show"/>
      </field>
    </field>
  </record>


  <!-- The cells themselves. A cell is a position on the cardboard; the caption is only
       ever shown here and on the product form, because the tag prints the value alone. -->
  <record id="view_yag_tag_cell_list" model="ir.ui.view">
    <field name="name">yag.tag.cell.list</field>
    <field name="model">yag.tag.cell</field>
    <field name="arch" type="xml">
      <list string="Tag cells" editable="bottom">
        <field name="fila"/>
        <field name="columna"/>
        <field name="name"/>
        <field name="code"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="action_yag_tag_cell" model="ir.actions.act_window">
    <field name="name">Tag cells</field>
    <field name="res_model">yag.tag.cell</field>
    <field name="view_mode">list</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Define the printable cells of the tag</p>
      <p>A cell is a position on the cardboard. The caption is shown on screen only:
         the tag prints the value alone, with no label.</p>
      <p>The spec block holds four rows at the current type. A fifth would print off
         the card, so fitting more means smaller type first.</p>
    </field>
  </record>

  <menuitem id="menu_yag_tag_cell" name="Tag cells"
            parent="stock.menu_stock_config_settings"
            action="action_yag_tag_cell" sequence="90"/>

</odoo>
