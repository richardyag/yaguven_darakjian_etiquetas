<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_yag_product_wizard_form" model="ir.ui.view">
    <field name="name">yag.product.wizard.form</field>
    <field name="model">yag.product.wizard</field>
    <field name="arch" type="xml">
      <form string="New product">
        <div class="alert alert-info" role="alert">
          Choose the category first: it decides which attributes are asked for, and they
          are the ones that print on the tag. An attribute left empty prints an empty
          cell -- nothing moves up to fill a gap.
        </div>
        <div class="alert alert-warning" role="alert" invisible="not aviso">
          <field name="aviso" readonly="1" nolabel="1"/>
          <field name="modelo_existente_id" readonly="1"
                 invisible="not modelo_existente_id"/>
        </div>
        <!-- The empty cells are said here, next to the form, and not thrown as an error
             at the last click: the person can still fill them in, and if the value is
             not known yet the product is created anyway. -->
        <div class="alert alert-warning" role="alert" invisible="not aviso_vacias">
          <field name="aviso_vacias" readonly="1" nolabel="1"/>
        </div>
        <group>
          <field name="image_1920" widget="image" class="oe_avatar" nolabel="1"/>
          <!-- The category comes FIRST: it decides which attributes are asked for, so
               choosing it before the name is the order the form actually works in. -->
          <group>
            <field name="categ_id" options="{'no_create': True, 'no_create_edit': True}"/>
            <field name="name" placeholder="e.g. Detrola on Bracelet 41mm"/>
            <field name="type" widget="radio" options="{'horizontal': True}"/>
          </group>
          <group>
            <field name="default_code" placeholder="e.g. WTCH.00086197"/>
            <field name="standard_price"/>
            <field name="list_price"/>
            <field name="is_storable" invisible="type != 'consu'"/>
            <field name="tracking" invisible="type != 'consu' or not is_storable"/>
          </group>
        </group>
        <div class="d-flex justify-content-end mb-2" invisible="not categ_id">
          <button name="action_recalcular_atributos" type="object"
                  string="Recalculate attributes" class="btn-secondary" icon="fa-refresh"
                  help="Click after answering a question like 'Has center stone?' so the attributes that depend on it show up or drop out."/>
        </div>
        <field name="line_ids" nolabel="1">
          <list editable="bottom" create="false" delete="false"
                decoration-warning="obligatorio and not value_ids">
            <field name="sequence" column_invisible="1"/>
            <field name="admite_varios" column_invisible="1"/>
            <field name="attribute_id" readonly="1" force_save="1"/>
            <!-- A value CAN be created from here on purpose. Blocking it stops the
                 person mid-load, and they will not wait: they leave the cell empty and
                 carry on, which is the very thing this wizard exists to prevent. A
                 misspelt value gets corrected later; an empty cell is noticed by nobody
                 until someone prints the tag. -->
            <field name="value_ids" widget="many2many_tags"
                   options="{'no_quick_create': True}"
                   context="{'default_attribute_id': attribute_id}"
                   domain="[('attribute_id', '=', attribute_id)]"/>
            <field name="slot" string="Tag cell" readonly="1" force_save="1" optional="show"/>
            <field name="obligatorio" string="Required" readonly="1" force_save="1" optional="show"/>
          </list>
        </field>
        <footer>
          <button name="action_crear" type="object" string="Create product"
                  class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_yag_product_wizard" model="ir.actions.act_window">
    <field name="name">New product (guided)</field>
    <field name="res_model">yag.product.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <menuitem id="menu_yag_product_wizard"
            name="New product (guided)"
            parent="stock.menu_stock_inventory_control"
            action="action_yag_product_wizard"
            sequence="5"/>

</odoo>
